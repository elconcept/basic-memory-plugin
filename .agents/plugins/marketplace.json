{
  "name": "elconcept-basic-memory",
  "interface": {
    "displayName": "Elconcept Basic Memory (Preview)"
  },
  "plugins": [
    {
      "name": "basic-memory-nas",
      "source": {
        "source": "local",
        "path": "./openai"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    },
    {
      "name": "basic-memory-nas-extras",
      "source": {
        "source": "local",
        "path": "./openai-extras"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_USE"
      },
      "category": "Productivity"
    }
  ]
}
